# FCB : renseigner .env.local ou l'environnement du processus. Aucune valeur sensible ici.
# Compte de service autorise en lecture sur les deux classeurs FCB.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Obligatoires pour les listes : IDs FCB fournis dans docs/FCB_VALIDATION.md.
FCB_STRUCTURE_TERRITORIALE_SPREADSHEET_ID=
FCB_REFERENTIELS_SPREADSHEET_ID=
# Necessaire aux protections existantes : classeur utilisateurs propre a FCB.
FCB_USERS_SPREADSHEET_ID=
# Deux secrets FCB aleatoires, distincts de FECOT et entre eux, 32 caracteres minimum.
AUTH_SECRET=
AUTH_TELEMETRY_HMAC_KEY=
# Ancienne variable seulement consultee comme garde anti-reutilisation : ne pas la renseigner.
FECOT_USERS_SPREADSHEET_ID=
# Ancien support medias conserve hors perimetre ; aucun televersement autorise dans ce lot.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLUB_LOGOS_FOLDER_ID=
GOOGLE_DRIVE_CLUBS_FOLDER_ID=
